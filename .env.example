# Verbindung zur echten Datenbank. Gehört in eine Datei außerhalb des Projektordners, nie ins Repository.
# Für jeden Host außer localhost muss die URL den Parameter sslmode=require enthalten (oder verify-ca,
# verify-full). require verschlüsselt, prüft aber das Serverzertifikat nicht.
DATABASE_URL=
# Nur zum bewussten Überschreiben vorhandener Seed-Tabellen: genau der Host der Datenbank (nicht yes).
SEED_CONFIRM_RESET=
# Datenbank für die Tests (tests/db, tests/seed und tests/mcp_server). Darf nie auf die echte Datenbank zeigen, nur localhost (Port 5432).
# Der Benutzer braucht das Recht CREATEROLE, für die Tests zu Superuser und BYPASSRLS einen Superuser.
TEST_DATABASE_URL=
# Datenservice hoffmann-data (mcp-server). Zugangstoken: mindestens 32 Zeichen, davon mindestens 10 verschiedene, nur druckbare ASCII-Zeichen,
# keine Leerzeichen oder Zeilenumbrüche. Erzeugen: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Der echte Wert liegt außerhalb des Projektordners, nie im Repository.
MCP_SERVER_TOKEN=
# Datenservice: Verbindung zur Datenbank unter der Nur-Lese-Rolle data_service_ro (db/roles/data_service_ro.sql), nicht
# DATABASE_URL des Seed-Skripts und nie die Rolle postgres. Pflicht für den Start (leer gilt wie nicht gesetzt).
# Format: postgresql://<rolle>:<passwort>@<host>:<port>/<datenbank>. Für jeden Host außer localhost muss die URL den Parameter
# sslmode=require (oder verify-ca, verify-full) enthalten. Beim Start prüft der Datenservice die Rolle und bricht ab, wenn sie mehr als lesen darf.
# Der echte Wert liegt außerhalb des Projektordners, nie im Repository.
MCP_SERVER_DATABASE_URL=
# Optional, leer gilt wie nicht gesetzt. Standard 127.0.0.1. Andere Werte als 127.0.0.1, localhost und ::1 brauchen MCP_SERVER_ALLOWED_HOSTS.
MCP_SERVER_HOST=
# Optional, leer gilt wie nicht gesetzt. Standard 8000.
MCP_SERVER_PORT=
# Optional, leer gilt wie nicht gesetzt. Erlaubte Werte des Host-Headers, kommagetrennt (z. B. daten.example.org:*). Nur bei Host außer Loopback.
MCP_SERVER_ALLOWED_HOSTS=
